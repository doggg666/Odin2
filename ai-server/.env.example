# local | cloud | auto
AI_MODE=local

# Local model server: ollama | lm_studio
LOCAL_BACKEND=lm_studio

# Start the LM Studio Local Server (default http://127.0.0.1:1234).
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Set to the exact model id returned by LM Studio's /v1/models endpoint.
LM_STUDIO_MODEL=replace-with-your-loaded-model-id

# Ollama settings (used only when LOCAL_BACKEND=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Optional cloud provider using an OpenAI-compatible API
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

ODIN_SYSTEM_PROMPT=You are Odin, a friendly, capable voice assistant. Be concise and natural when speaking. If you are unsure, say so.
MAX_IMAGE_BYTES=12000000
